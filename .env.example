# All inference routes through OpenRouter — one key, one provider.
# Embeddings + generation both use this key.
OPENROUTER_API_KEY=

# Embedding model — switching means re-indexing everything.
EMBEDDING_MODEL=openai/text-embedding-3-large

# Generator model — any OpenRouter chat model.
GENERATOR_MODEL=openai/gpt-4o-mini

# Judge model — MUST differ from the generator model (no model grades itself).
JUDGE_MODEL=openai/gpt-4o

# Cross-encoder reranker (sentence-transformers, local — no key)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# pgvector (local compose maps host 5433 → 5432)
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Auth — static demo bearer tokens. Empty = auth disabled (local only).
# JSON object mapping tenant_id -> token.
RCC_TENANT_TOKENS=
# Operator token gating /observability.
RCC_OPERATOR_TOKEN=

# OTEL exporter (optional — spans are emitted when set)
OTEL_EXPORTER_OTLP_ENDPOINT=
